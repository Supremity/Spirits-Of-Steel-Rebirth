{
	"Factory": {
		"build_cost": {
			"money": "500.0",
			"required_tags": "has_tag('structural_metal')"
		},
		"requirements": "true",
		"input": [
			{
				"match": "has_tag('structural_metal')",
				"amount": {
					"min": "5.0",
					"max": "20.0"
				}
			},
			{
				"amount": "10.0",
				"resource_tag": "power"
			}
		],
		"output": [
			{
				"tag": "produces",
				"amount": "input_tag_val(0, 'structural_metal') * 2.0"
			}
		]
	},
	"Civilian Center": {
		"build_cost": {
			"money": "150.0",
			"required_tags": "has_tag('wood') or has_tag('stone')"
		},
		"requirements": "true",
		"input": [
			{
				"amount": "5.0",
				"resource_tag": "water"
			}
		],
		"output": [
			{
				"tag": "population",
				"amount": "10.0"
			}
		]
	},
	"Hospital": {
		"build_cost": {
			"money": "300.0"
		},
		"requirements": "true",
		"input": [
			{
				"match": "has_tag('electronic')",
				"amount": "5.0"
			},
			{
				"amount": "5.0",
				"resource_tag": "power"
			},
			{
				"amount": "2.0",
				"resource_tag": "water"
			},
			{
				"amount": "5.0",
				"resource_tag": "money"
			}
		],
		"output": [
			{
				"tag": "heal_amount",
				"amount": "input_tag_val(0, 'electronic') * 5.0"
			}
		]
	},
	"Research Center": {
		"build_cost": {
			"money": "1000.0",
			"required_tags": "has_tag('electronic') and has_tag('structural_metal')"
		},
		"requirements": "true",
		"input": [
			{
				"match": "has_tag('electronic')",
				"amount": "15.0"
			},
			{
				"amount": "15.0",
				"resource_tag": "power"
			},
			{
				"amount": "10.0",
				"resource_tag": "money"
			}
		],
		"output": [
			{
				"tag": "tech_points",
				"amount": "input_tag_val(0, 'electronic') * 2.0"
			}
		]
	},
	"Storage": {
		"build_cost": {
			"money": "100.0",
			"required_tags": "has_tag('wood') or has_tag('structural_metal')"
		},
		"requirements": "true",
		"input": [
			{
				"match": "has_tag('wood') or has_tag('structural_metal')",
				"amount": "5.0"
			}
		],
		"output": [
			{
				"tag": "storage",
				"amount": "input_tag_val(0, 'wood') * 5.0 + input_tag_val(0, 'structural_metal') * 10.0"
			}
		]
	},
	"Port": {
		"build_cost": {
			"money": "400.0",
			"required_tags": "has_tag('wood') or has_tag('structural_metal')"
		},
		"requirements": "true",
		"input": [
			{
				"match": "has_tag('wood') or has_tag('structural_metal')",
				"amount": "5.0"
			}
		],
		"output": [
			{
				"tag": "on_coast",
				"amount": "1.0"
			},
			{
				"tag": "supply_amount",
				"amount": "(input_tag_val(0, 'wood') + input_tag_val(0, 'structural_metal')) * 5.0"
			}
		]
	},
	"Generator": {
		"build_cost": {
			"money": "200.0",
			"required_tags": "has_tag('structural_metal')"
		},
		"requirements": "true",
		"input": [
			{
				"match": "has_tag('fuel')",
				"amount": "5.0"
			},
			{
				"amount": "2.0",
				"resource_tag": "money"
			}
		],
		"output": [
			{
				"tag": "power",
				"amount": "input_tag_val(0, 'fuel') * 5.0"
			}
		]
	},
	"Chemical Plant": {
		"build_cost": {
			"money": "1000.0"
		},
		"requirements": "true",
		"input": [
			{
				"match": "has_tag('poison')",
				"amount": "20.0"
			},
			{
				"match": "has_tag('nitrate')",
				"amount": "20.0"
			},
			{
				"amount": "50.0",
				"resource_tag": "power"
			}
		],
		"output": [
			{
				"tag": "produces",
				"amount": "input_tag_val(0, 'poison') * 2.0 + input_tag_val(1, 'nitrate')"
			}
		]
	}
}
